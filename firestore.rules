// Copy of the rules published in the Firebase console (Firestore → Rules); no CLI deploy, paste changes there by hand.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each user reads and writes only their own cards, stats and settings
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // owner's API keys (store.js saveKeys/loadKeys): the allowlist may read them, only the owner may change them
    match /shared/keys {
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['mukshin.an@gmail.com'];
      allow write: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'mukshin.an@gmail.com';
    }
  }
}
